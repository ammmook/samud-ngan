# Client ID ของ Google (OAuth 2.0 Web) ใส่แล้วปุ่ม "ลงชื่อเข้าใช้ด้วย Google" จะใช้งานได้
# สร้างที่ https://console.cloud.google.com/apis/credentials แล้วเพิ่ม http://localhost:5175 ใน Authorized JavaScript origins
# ทั้งหน้าเว็บ (ปุ่ม) และเซิร์ฟเวอร์ (ตรวจ ID token) ใช้ค่าเดียวกันนี้
VITE_GOOGLE_CLIENT_ID=

# กุญแจลงนาม session cookie ของเซิร์ฟเวอร์ (สุ่มอย่างน้อย 32 ตัวอักษร):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# DATABASE_URL, AWS_* ฯลฯ มาจาก `neon deploy` ลงใน .env.local อัตโนมัติ
