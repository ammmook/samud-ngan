    "@neon/auth": "^0.8.2",
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "files-sdk": "^3.2.0",
    "jose": "^6.2.17",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.7",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
